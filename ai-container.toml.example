# Copy to ~/.config/ai-container.toml (or point $AI_CONTAINER_CONFIG at it).
# Every setting is optional and commented out. Each key notes its real default;
# the sample values are illustrations only. The file ships as a no-op.
# CLI flags override scalars and are merged (de-duplicated) into lists.

# Forward the host SSH agent into the container. Default: true.
# Flag: --ssh-agent / --no-ssh-agent.
# ssh_agent = false

# Extra /etc/hosts entries as host:ip (podman and docker). Default: [].
# Flag: --add-host.
# add_hosts = ["openqa-ai.qam.suse.cz:169.254.1.2"]

# Raw extra engine network args, one token per entry. A --network=... entry replaces
# the default --network=pasta (podman). Default: []. Flag: --network-arg.
# Example: pasta on host interface dummy0 (-i) with container address (-a), prefix (-n)
# and gateway (-g), plus a DNS server. Use 172.29.0.1 as DNS only if the host runs one.
# extra_network_args = ["--network=pasta:-i,dummy0,-a,172.29.0.2,-n,24,-g,172.29.0.1", "--dns=1.1.1.1"]

# Environment for the container, on top of the built-in Vertex AI variables (see the
# README). Nothing else is set by default. NAME forwards the host value when
# set; NAME=value sets a literal, where ${HOST_VAR} expands from the host (entry is
# skipped if a referenced variable is unset). Flag: --extra-env. Wins over disable_envs.
# extra_envs = ["BUGZILLA_API_KEY", "VERTEXAI_PROJECT=${GCLOUD_PROJECT}"]

# Env vars whose value is the stdout of a host command, run at launch without a shell
# (no pipes/&&). Skipped if the command fails or prints nothing. Wins over extra_envs;
# --extra-env and disable_envs win over it. Default: {}.
# export_vars = { GH_TOKEN = "gh auth token" }

# Env var names to NOT set, built-in Vertex ones included. Default: []. Flag: --disable-env.
# disable_envs = ["PUSHOVER_TOKEN"]

# Host paths (directories or files) to bind-mount, on top of the built-in rw mounts of
# ~/.agents, ~/.claude, ~/.claude.json and OpenCode's config/data/state/cache: SOURCE[:TARGET][:ro|rw], rw by default.
# Without TARGET, paths under $HOME map to the same place under /home/coder. Relative
# SOURCEs resolve from the launch directory; missing ones are skipped. The CLI wins on
# target clashes and over disable_mounts. Default: []. Flag: --extra-mount / -m.
# extra_mounts = ["~/.claude", "~/.claude.json", "~/.config/gh:ro", "~/src:/opt/src:ro"]

# Absolute host paths; any config or built-in mount (and ~/.ssh/known_hosts) at or below
# one is skipped. CLI --extra-mount entries are never filtered. Default: []. Flag: --disable-mount.
# disable_mounts = ["~/.aws", "~/.kube"]

# Load a [[workspace]] automatically when the launch directory is inside its dirs.
# Default: false.
# auto_workspaces = true

# Named directory groups mounted together with --workspace NAME. Default: none.
# [[workspace]]
# Workspace name, passed to --workspace.
# name = "frontend"
# Host directories to mount read-write (non-empty list).
# dirs = ["~/repos/app", "~/repos/shared"]
