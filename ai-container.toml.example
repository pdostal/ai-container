# Copy to ~/.config/ai-container.toml (or point $AI_CONTAINER_CONFIG at it).
# Every setting is optional and commented out. Each key notes its real default;
# the sample values are illustrations only. The file ships as a no-op.
# CLI flags override scalars and are merged (de-duplicated) into lists.

# Forward the host SSH agent into the container. Default: true.
# Flag: --ssh-agent / --no-ssh-agent.
# ssh_agent = false

# Extra /etc/hosts entries as host:ip (podman only). Default: [].
# Flag: --add-host.
# add_hosts = ["openqa-ai.qam.suse.cz:169.254.1.2"]

# Host env var names to forward when set, on top of the built-in list
# (ANTHROPIC_VERTEX_PROJECT_ID, BUGZILLA_API_KEY, REDMINE_API_KEY, PUSHOVER_USER,
# PUSHOVER_TOKEN). Wins over disable_envs. Default: []. Flag: --extra-env.
# extra_envs = ["MY_VARIABLE"]

# Built-in env var names to NOT forward. Default: []. Flag: --disable-env.
# disable_envs = ["PUSHOVER_TOKEN"]

# Extra host directories to bind-mount read-write; relative paths resolve from the
# launch directory. Wins over disable_mounts. Default: []. Flag: --extra-mount / -m.
# extra_mounts = ["~/src/shared"]

# Absolute host paths; any default credential/cache mount (incl. gcloud) at or below
# one is skipped. Example: "~/.config" drops gh, glab (Linux), osc, tea, openqa, opencode
# and gcloud; add "~/.config/gh" to extra_mounts to bring one back (rw).
# Default: []. Flag: --disable-mount.
# disable_mounts = ["~/.aws", "~/.kube"]

# Load a [[workspace]] automatically when the launch directory is inside its dirs.
# Default: false.
# auto_workspaces = true

# Named directory groups mounted together with --workspace NAME. Default: none.
# [[workspace]]
# Workspace name, passed to --workspace.
# name = "frontend"
# Host directories to mount read-write (non-empty list).
# dirs = ["~/repos/app", "~/repos/shared"]
