#!/usr/bin/env bash

# Interactive TUI entrypoints put the terminal into raw mode; if the
# container exits abnormally without restoring it, the outer shell is left
# broken (no echo, garbled prompt). Reset it unconditionally on exit.
trap 'stty sane 2>/dev/null' EXIT

host_home="${HOME}"
container_home="/home/coder"
platform="$(uname -s)"
engine="${AI_CONTAINER_RUNTIME:-}"

# Parse command-line arguments
entrypoint="${container_home}/.opencode/bin/opencode"
web_mode=false
web_port=4996
web_password=""
web_username="coder"
auto_worktree_mount=true
debug_mode=false
extra_mount_paths=()
remaining_args=()

while true; do
  case "$1" in
    --entrypoint)       entrypoint="$2"; shift 2 ;;
    --claude)           entrypoint="${container_home}/.local/bin/claude"; shift ;;
    --opencode)         entrypoint="${container_home}/.opencode/bin/opencode"; shift ;;
    --web)              web_mode=true; shift ;;
    --web-port)         web_port="$2"; shift 2 ;;
    --web-password)     web_password="$2"; shift 2 ;;
    --web-username)     web_username="$2"; shift 2 ;;
    --mount-extra)      extra_mount_paths+=("$2"); shift 2 ;;
    --no-worktree-mount) auto_worktree_mount=false; shift ;;
    --debug)            debug_mode=true; shift ;;
    --runtime)          engine="$2"; shift 2 ;;
    --) shift; break ;;
    *) break ;;
  esac
done

remaining_args=("$@")

# Pick a container engine: explicit --runtime/$AI_CONTAINER_RUNTIME wins;
# otherwise default to podman everywhere, falling back to Apple's `container`
# on macOS if podman isn't installed.
if [[ -z "$engine" ]]; then
  if command -v podman &>/dev/null; then
    engine="podman"
  elif [[ "$platform" == "Darwin" ]] && command -v container &>/dev/null; then
    engine="container"
  else
    engine="podman"
  fi
fi

case "$engine" in
  podman|container) ;;
  *)
    echo "✗ Unknown --runtime/AI_CONTAINER_RUNTIME value: $engine (expected 'podman' or 'container')" >&2
    exit 1
    ;;
esac

if ! command -v "$engine" &>/dev/null; then
  echo "✗ Selected runtime '$engine' not found on \$PATH" >&2
  exit 1
fi

if [[ "$engine" == "container" ]]; then
  image="ai"
else
  image="localhost/ai"
fi

# Debug-only output helpers. Mount/env-var/SELinux status noise is hidden
# unless --debug is passed; the container engine and opencode also get extra
# debug logging.
debug_echo() { [[ "$debug_mode" == "true" ]] && echo "$@"; }
debug_echo_err() { [[ "$debug_mode" == "true" ]] && echo "$@" >&2; }

# Detect SELinux
selinux_label=""
if [[ "$platform" != "Darwin" ]] && command -v sestatus &>/dev/null; then
  selinux_status=$(sestatus 2>/dev/null)
  if echo "$selinux_status" | grep -q "SELinux status:.*enabled"; then
    mode=$(echo "$selinux_status" | grep "Current mode:" | awk '{print $3}')
    if [[ -n "$mode" ]]; then
      debug_echo "✓ SELinux detected ($mode mode)"
    else
      debug_echo "✓ SELinux detected (enabled)"
    fi
    selinux_label=":z"
  else
    debug_echo "○ SELinux not detected"
  fi
else
  debug_echo "○ SELinux not detected (sestatus not available)"
fi

# Generate random container name (exclude ambiguous chars: 0, 1, i, l, o)
# set +o pipefail guards against `tr` getting SIGPIPE'd when `head` closes
# the pipe early, which would otherwise look like a failure under pipefail.
suffix="$(set +o pipefail; LC_ALL=C tr -dc 'acdefghjkmnpqrstuvwxyz23456789' < /dev/urandom | head -c 3)"
container_name="ai-${suffix}"

gcloud_creds="${host_home}/.config/gcloud/application_default_credentials.json"
gcloud_creds_target="${container_home}/.config/gcloud/application_default_credentials.json"
claude_dir="${host_home}/.claude"
claude_dir_target="${container_home}/.claude"
claude_json="${host_home}/.claude.json"
claude_json_target="${container_home}/.claude.json"
gh_config="${host_home}/.config/gh"
gh_config_target="${container_home}/.config/gh"
opencode_config="${host_home}/.config/opencode"
opencode_config_target="${container_home}/.config/opencode"
opencode_data="${host_home}/.local/share/opencode"
opencode_data_target="${container_home}/.local/share/opencode"
opencode_state="${host_home}/.local/state/opencode"
opencode_state_target="${container_home}/.local/state/opencode"
opencode_cache="${host_home}/.cache/opencode"
opencode_cache_target="${container_home}/.cache/opencode"
npm_cache="${host_home}/.npm"
npm_cache_target="${container_home}/.npm"
go_mod_cache="${host_home}/go/pkg/mod"
go_mod_cache_target="${container_home}/go/pkg/mod"
go_build_cache="${host_home}/.cache/go-build"
go_build_cache_target="${container_home}/.cache/go-build"
cargo_registry_cache="${host_home}/.cargo/registry"
cargo_registry_cache_target="${container_home}/.cargo/registry"
cargo_git_cache="${host_home}/.cargo/git"
cargo_git_cache_target="${container_home}/.cargo/git"
pip_cache="${host_home}/.cache/pip"
pip_cache_target="${container_home}/.cache/pip"
uv_cache="${host_home}/.cache/uv"
uv_cache_target="${container_home}/.cache/uv"
glab_config="${host_home}/.config/glab-cli"
glab_config_alt="${host_home}/Library/Application Support/glab-cli"
if [[ -d "$glab_config_alt" ]]; then
  glab_config="$glab_config_alt"
fi
glab_config_target="${container_home}/.config/glab-cli"
ssh_known_hosts="${host_home}/.ssh/known_hosts"
ssh_known_hosts_target="${container_home}/.ssh/known_hosts"
gitconfig="${host_home}/.gitconfig"
gitconfig_target="${container_home}/.gitconfig"
openqa_config="${host_home}/.config/openqa"
openqa_config_target="${container_home}/.config/openqa"
ssh_auth_sock_target="${container_home}/.ssh/agent/ssh-agent.sock"
kube_config="${host_home}/.kube"
kube_config_target="${container_home}/.kube"
osc_config="${host_home}/.config/osc"
osc_config_target="${container_home}/.config/osc"
tea_config="${host_home}/.config/tea"
tea_config_target="${container_home}/.config/tea"
aws_config="${host_home}/.aws"
aws_config_target="${container_home}/.aws"

map_to_container_path() {
  case "$1" in
    "$host_home"/*) echo "${container_home}${1#"$host_home"}" ;;
    *) echo "$1" ;;
  esac
}

if [[ -z "$PWD" ]]; then
  echo "✗ PWD is empty; refusing to bind-mount workdir" >&2
  exit 1
fi

if [[ "$PWD" == "$host_home" ]]; then
  echo "✗ Refusing to run: current directory is your entire \$HOME ($host_home)" >&2
  echo "  Run this from a project subdirectory instead." >&2
  exit 1
fi

target_workdir="$(map_to_container_path "$PWD")"

# Auto-detect git worktrees and queue the parent (main) checkout for mounting
if [[ "$auto_worktree_mount" == "true" ]]; then
  if common_dir=$(git -C "$PWD" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) && \
     git_dir=$(git -C "$PWD" rev-parse --path-format=absolute --git-dir 2>/dev/null); then
    if [[ "$common_dir" != "$git_dir" ]]; then
      worktree_parent="$(dirname "$common_dir")"
      extra_mount_paths+=("$worktree_parent")
      echo "✓ Detected git worktree; auto-mounting parent repo: $worktree_parent"
    fi
  fi
fi

args=(
  --rm
  --name "${container_name}"
  -e HOME="${container_home}"
  -w "${target_workdir}"
  "--mount=type=bind,source=${PWD},target=${target_workdir}$([ -n "$selinux_label" ] && echo ",z")"
)

if [[ "$engine" == "podman" ]]; then
  # `container` has no hostname flag and no SELinux concept; the container
  # name already becomes its hostname there.
  args+=(-h ai)
  args+=(--security-opt label=disable)
else
  # `container`'s bind mounts show every file owned by whatever uid/gid the
  # process runs as (not the host's real owner), so match the host user here
  # instead of relying on userns remapping.
  args+=(--uid "$(id -u)" --gid "$(id -g)")
fi

debug_echo "✓ Mounting working directory (bind-mount, rw): ${PWD} → ${target_workdir}"

# Extra rw mounts (manual --mount-extra and/or auto-detected worktree parent)
declare -A mounted_targets=(["$target_workdir"]=1)
for raw_path in "${extra_mount_paths[@]}"; do
  if [[ ! -d "$raw_path" ]]; then
    debug_echo_err "✗ Extra mount path not found, skipping: $raw_path"
    continue
  fi
  resolved="$(cd "$raw_path" && pwd)"
  extra_target="$(map_to_container_path "$resolved")"
  if [[ -n "${mounted_targets[$extra_target]:-}" ]]; then
    continue
  fi
  mounted_targets["$extra_target"]=1
  debug_echo "✓ Mounting extra directory (bind-mount, rw): ${resolved} → ${extra_target}"
  args+=("--mount=type=bind,source=${resolved},target=${extra_target}$([ -n "$selinux_label" ] && echo ",z")")
done

# Google Cloud credentials
if [[ -f "$gcloud_creds" ]]; then
  debug_echo "✓ Mounting Google Cloud credentials (bind-mount, ro): $gcloud_creds"
  if [[ -n "$selinux_label" ]]; then
    args+=(-v "$gcloud_creds:$gcloud_creds_target:Z,ro")
  else
    args+=(-v "$gcloud_creds:$gcloud_creds_target:ro")
  fi
  args+=(-e GOOGLE_APPLICATION_CREDENTIALS="$gcloud_creds_target")
  args+=(-e GOOGLE_CLOUD_PROJECT=REDACTED-GCP-PROJECT)
  args+=(-e VERTEX_LOCATION=global)
  args+=(-e VERTEXAI_PROJECT=REDACTED-GCP-PROJECT)
  args+=(-e VERTEXAI_LOCATION=global)
  debug_echo "  → Setting GOOGLE_APPLICATION_CREDENTIALS=$gcloud_creds_target"
  debug_echo "  → Setting GOOGLE_CLOUD_PROJECT=REDACTED-GCP-PROJECT"
  debug_echo "  → Setting VERTEX_LOCATION=global"
  debug_echo "  → Setting VERTEXAI_PROJECT=REDACTED-GCP-PROJECT"
  debug_echo "  → Setting VERTEXAI_LOCATION=global"
else
  debug_echo_err "✗ Google Cloud credentials not found: $gcloud_creds"
fi

# Claude config directory
if [[ -d "$claude_dir" ]]; then
  debug_echo "✓ Mounting Claude config directory (bind-mount, rw): $claude_dir"
  args+=(-v "$claude_dir:$claude_dir_target${selinux_label}")
else
  debug_echo_err "✗ Claude config directory not found: $claude_dir"
fi

# Claude config file
if [[ -f "$claude_json" ]]; then
  debug_echo "✓ Mounting Claude config file (bind-mount, rw): $claude_json"
  args+=(-v "$claude_json:$claude_json_target${selinux_label}")
else
  debug_echo_err "✗ Claude config file not found: $claude_json"
fi

# GitHub CLI config
if [[ -d "$gh_config" ]]; then
  debug_echo "✓ Mounting GitHub CLI config (bind-mount, ro): $gh_config"
  if [[ -n "$selinux_label" ]]; then
    args+=(-v "$gh_config:$gh_config_target:Z,ro")
  else
    args+=(-v "$gh_config:$gh_config_target:ro")
  fi
else
  debug_echo_err "✗ GitHub CLI config not found: $gh_config"
fi

# GitLab CLI config
if [[ -d "$glab_config" ]]; then
  debug_echo "✓ Mounting GitLab CLI config (bind-mount, ro): $glab_config"
  if [[ -n "$selinux_label" ]]; then
    args+=(-v "$glab_config:$glab_config_target:Z,ro")
  else
    args+=(-v "$glab_config:$glab_config_target:ro")
  fi
else
  debug_echo_err "✗ GitLab CLI config not found: $glab_config"
fi

# OpenCode config
if [[ -d "$opencode_config" ]]; then
  debug_echo "✓ Mounting OpenCode config directory (bind-mount, rw): $opencode_config"
  args+=(-v "$opencode_config:$opencode_config_target${selinux_label}")
else
  debug_echo_err "✗ OpenCode config directory not found: $opencode_config"
fi

# OpenCode data
if [[ -d "$opencode_data" ]]; then
  debug_echo "✓ Mounting OpenCode data directory (bind-mount, rw): $opencode_data"
  args+=(-v "$opencode_data:$opencode_data_target${selinux_label}")
else
  debug_echo_err "✗ OpenCode data directory not found: $opencode_data"
fi

# OpenCode state
if [[ -d "$opencode_state" ]]; then
  debug_echo "✓ Mounting OpenCode state directory (bind-mount, rw): $opencode_state"
  args+=(-v "$opencode_state:$opencode_state_target${selinux_label}")
else
  debug_echo_err "✗ OpenCode state directory not found: $opencode_state"
fi

# OpenCode cache
if [[ -d "$opencode_cache" ]]; then
  debug_echo "✓ Mounting OpenCode cache directory (bind-mount, rw): $opencode_cache"
  args+=(-v "$opencode_cache:$opencode_cache_target${selinux_label}")
else
  debug_echo_err "✗ OpenCode cache directory not found: $opencode_cache"
fi

# All LSP servers opencode would otherwise auto-install at runtime are baked
# into the image already; skip the network probing/download path entirely.
args+=(-e OPENCODE_DISABLE_LSP_DOWNLOAD=true)
debug_echo "  → Setting OPENCODE_DISABLE_LSP_DOWNLOAD=true"

# Toolchain caches (npm, go, cargo, pip, uv)
if [[ -d "$npm_cache" ]]; then
  debug_echo "✓ Mounting npm cache directory (bind-mount, rw): $npm_cache"
  args+=(-v "$npm_cache:$npm_cache_target${selinux_label}")
else
  debug_echo_err "✗ npm cache directory not found: $npm_cache"
fi

if [[ -d "$go_mod_cache" ]]; then
  debug_echo "✓ Mounting Go module cache directory (bind-mount, rw): $go_mod_cache"
  args+=(-v "$go_mod_cache:$go_mod_cache_target${selinux_label}")
else
  debug_echo_err "✗ Go module cache directory not found: $go_mod_cache"
fi

if [[ -d "$go_build_cache" ]]; then
  debug_echo "✓ Mounting Go build cache directory (bind-mount, rw): $go_build_cache"
  args+=(-v "$go_build_cache:$go_build_cache_target${selinux_label}")
else
  debug_echo_err "✗ Go build cache directory not found: $go_build_cache"
fi

if [[ -d "$cargo_registry_cache" ]]; then
  debug_echo "✓ Mounting Cargo registry cache directory (bind-mount, rw): $cargo_registry_cache"
  args+=(-v "$cargo_registry_cache:$cargo_registry_cache_target${selinux_label}")
else
  debug_echo_err "✗ Cargo registry cache directory not found: $cargo_registry_cache"
fi

if [[ -d "$cargo_git_cache" ]]; then
  debug_echo "✓ Mounting Cargo git cache directory (bind-mount, rw): $cargo_git_cache"
  args+=(-v "$cargo_git_cache:$cargo_git_cache_target${selinux_label}")
else
  debug_echo_err "✗ Cargo git cache directory not found: $cargo_git_cache"
fi

if [[ -d "$pip_cache" ]]; then
  debug_echo "✓ Mounting pip cache directory (bind-mount, rw): $pip_cache"
  args+=(-v "$pip_cache:$pip_cache_target${selinux_label}")
else
  debug_echo_err "✗ pip cache directory not found: $pip_cache"
fi

if [[ -d "$uv_cache" ]]; then
  debug_echo "✓ Mounting uv cache directory (bind-mount, rw): $uv_cache"
  args+=(-v "$uv_cache:$uv_cache_target${selinux_label}")
else
  debug_echo_err "✗ uv cache directory not found: $uv_cache"
fi

# SSH agent
ssh_forwarding=false
if [[ "$engine" == "container" ]]; then
  # `container`'s virtiofs bind mounts can't carry a raw AF_UNIX socket file
  # (confirmed: the socket node isn't readable through the share), so use
  # its built-in forwarding flag instead of a manual mount.
  if [[ -n "$SSH_AUTH_SOCK" ]] && [[ -S "$SSH_AUTH_SOCK" ]]; then
    debug_echo "✓ Forwarding SSH agent socket (--ssh): $SSH_AUTH_SOCK"
    args+=(--ssh)
    ssh_forwarding=true
  else
    debug_echo_err "✗ SSH agent socket not available"
  fi
elif [[ -n "$SSH_AUTH_SOCK" ]] && [[ -S "$SSH_AUTH_SOCK" ]]; then
  debug_echo "✓ Mounting SSH agent socket (bind-mount, rw): $SSH_AUTH_SOCK"
  args+=("--mount=type=bind,source=${SSH_AUTH_SOCK},target=${ssh_auth_sock_target}$([ -n "$selinux_label" ] && echo ",z")")
  args+=(-e SSH_AUTH_SOCK="${ssh_auth_sock_target}")
  debug_echo "  → Setting SSH_AUTH_SOCK=$ssh_auth_sock_target"
else
  debug_echo_err "✗ SSH agent socket not available"
fi

# SSH known_hosts
if [[ -f "$ssh_known_hosts" ]]; then
  debug_echo "✓ Mounting SSH known_hosts (bind-mount, ro): $ssh_known_hosts"
  if [[ -n "$selinux_label" ]]; then
    args+=(-v "$ssh_known_hosts:$ssh_known_hosts_target:Z,ro")
  else
    args+=(-v "$ssh_known_hosts:$ssh_known_hosts_target:ro")
  fi
else
  debug_echo_err "✗ SSH known_hosts not found: $ssh_known_hosts"
fi

# Git config
if [[ -f "$gitconfig" ]]; then
  debug_echo "✓ Mounting Git config (bind-mount, ro): $gitconfig"
  if [[ -n "$selinux_label" ]]; then
    args+=(-v "$gitconfig:$gitconfig_target:Z,ro")
  else
    args+=(-v "$gitconfig:$gitconfig_target:ro")
  fi
else
  debug_echo_err "✗ Git config not found: $gitconfig"
fi

# openQA config directory
if [[ -d "$openqa_config" ]]; then
  debug_echo "✓ Mounting openQA config directory (bind-mount, ro): $openqa_config"
  if [[ -n "$selinux_label" ]]; then
    args+=(-v "$openqa_config:$openqa_config_target:Z,ro")
  else
    args+=(-v "$openqa_config:$openqa_config_target:ro")
  fi
else
  debug_echo_err "✗ openQA config directory not found: $openqa_config"
fi

# Bugzilla API key
if [[ -n "$BUGZILLA_API_KEY" ]]; then
  debug_echo "✓ Forwarding BUGZILLA_API_KEY environment variable"
  args+=(-e BUGZILLA_API_KEY="${BUGZILLA_API_KEY}")
else
  debug_echo_err "✗ BUGZILLA_API_KEY not set"
fi

# Redmine API key
if [[ -n "$REDMINE_API_KEY" ]]; then
  debug_echo "✓ Forwarding REDMINE_API_KEY environment variable"
  args+=(-e REDMINE_API_KEY="${REDMINE_API_KEY}")
else
  debug_echo_err "✗ REDMINE_API_KEY not set"
fi

# osc config
if [[ -d "$osc_config" ]]; then
  debug_echo "✓ Mounting osc config directory (bind-mount, rw): $osc_config"
  args+=(-v "$osc_config:$osc_config_target${selinux_label}")
else
  debug_echo_err "✗ osc config directory not found: $osc_config"
fi

# tea config
if [[ -d "$tea_config" ]]; then
  debug_echo "✓ Mounting tea config directory (bind-mount, rw): $tea_config"
  args+=(-v "$tea_config:$tea_config_target${selinux_label}")
else
  debug_echo_err "✗ tea config directory not found: $tea_config"
fi

# AWS config
if [[ -d "$aws_config" ]]; then
  debug_echo "✓ Mounting AWS config directory (bind-mount, rw): $aws_config"
  args+=(-v "$aws_config:$aws_config_target${selinux_label}")
else
  debug_echo_err "✗ AWS config directory not found: $aws_config"
fi

# Kubernetes config
if [[ -d "$kube_config" ]]; then
  debug_echo "✓ Mounting Kubernetes config (bind-mount, rw): $kube_config"
  args+=(-v "$kube_config:$kube_config_target${selinux_label}")
else
  debug_echo_err "✗ Kubernetes config not found: $kube_config"
fi

if [[ "$web_mode" == "true" ]]; then
  if [[ -z "$web_password" ]]; then
    web_password="$(set +o pipefail; LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 20)"
  fi
  args+=(-d)
  args+=(-p "${web_port}:${web_port}")
  args+=(-e OPENCODE_SERVER_PASSWORD="${web_password}")
  args+=(-e OPENCODE_SERVER_USERNAME="${web_username}")
  remaining_args=("web" "--hostname" "0.0.0.0" "--port" "$web_port" "${remaining_args[@]}")
  if [[ "$platform" == "Darwin" ]]; then
    host_ip="$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null)"
    [[ -z "$host_ip" ]] && host_ip="localhost"
  else
    host_ip="$(hostname -I | awk '{print $1}')"
  fi
  echo "✓ Web mode: http://${host_ip}:${web_port}"
  echo "✓ Web username: ${web_username}"
  echo "✓ Web password: ${web_password}"
elif [[ -t 0 && -t 1 ]]; then
  if [[ "$engine" == "podman" ]]; then
    args+=(-it)
  else
    args+=(-i -t)
  fi
else
  args+=(-i)
  debug_echo "○ No TTY detected; running without -t"
fi

if [[ "$engine" == "podman" ]]; then
  args+=("--network=pasta")
  args+=("--userns=keep-id")
  #args+=("--runtime crun-vm")
fi

# Debug mode: verbose engine logging, plus opencode's own debug-level startup
# log streamed live instead of only landing in its log file.
engine_debug_args=()
if [[ "$debug_mode" == "true" ]]; then
  if [[ "$engine" == "podman" ]]; then
    engine_debug_args=(--log-level=debug)
  else
    engine_debug_args=(--debug)
  fi
  if [[ "$entrypoint" == *"/opencode" ]]; then
    remaining_args=(--print-logs --log-level DEBUG "${remaining_args[@]}")
  fi
fi

echo "✓ ${engine} container: ${container_name}"
echo "▶ Using entrypoint: $entrypoint"
echo "▶ Passing params: ${remaining_args[*]}"
echo ""

if [[ "$ssh_forwarding" == "true" ]]; then
  # `--ssh`'s relay socket is always created root-owned inside the guest, so
  # our non-root --uid/--gid process can't reach it (see README). Loosen the
  # permissions on that per-container relay copy in the background once the
  # container is up; this doesn't touch the real host ssh-agent socket.
  (
    for _ in $(seq 1 10); do
      "$engine" exec -u root "$container_name" \
        sh -c 'test -S /var/host-services/ssh-auth.sock && chmod 0666 /var/host-services/ssh-auth.sock' \
        >/dev/null 2>&1 && break
      sleep 5
    done
  ) &
fi

"$engine" "${engine_debug_args[@]}" run --init --entrypoint "$entrypoint" "${args[@]}" "$image" "${remaining_args[@]}"
