#!/usr/bin/env bash

# Detect SELinux
selinux_label=""
if command -v sestatus &>/dev/null; then
  selinux_status=$(sestatus 2>/dev/null)
  if echo "$selinux_status" | grep -q "SELinux status:.*enabled"; then
    mode=$(echo "$selinux_status" | grep "Current mode:" | awk '{print $3}')
    if [[ -n "$mode" ]]; then
      echo "✓ SELinux detected ($mode mode)"
    else
      echo "✓ SELinux detected (enabled)"
    fi
    selinux_label=":z"
  else
    echo "○ SELinux not detected"
  fi
else
  echo "○ SELinux not detected (sestatus not available)"
fi

# Parse command-line arguments
entrypoint="/home/pdostal/.local/bin/claude"
remaining_args=()

if ! TEMP=$(getopt -o '' --long entrypoint: -n 'ai-container' -- "$@"); then
  exit 1
fi
eval set -- "$TEMP"

while true; do
  case "$1" in
    --entrypoint) entrypoint="$2"; shift 2 ;;
    --) shift; break ;;
    *) break ;;
  esac
done

remaining_args=("$@")

gcloud_creds="/home/pdostal/.config/gcloud/application_default_credentials.json"
claude_dir="/home/pdostal/.claude"
claude_json="/home/pdostal/.claude.json"
gh_config="/home/pdostal/.config/gh"
glab_config="/home/pdostal/.config/glab-cli"
ssh_known_hosts="/home/pdostal/.ssh/known_hosts"
gitconfig="/home/pdostal/.gitconfig"
osc="/home/pdostal/.config/osc"
gpg_socket="$(gpgconf --list-dir agent-socket)"

args=(
  -it --rm
  --userns=keep-id
  --name ai
  -h ai
  --security-opt label=disable
  "--mount=type=bind,source=${PWD},target=/workdir$([ -n "$selinux_label" ] && echo ",z")"
)

# Google Cloud credentials
if [[ -f "$gcloud_creds" ]]; then
  echo "✓ Mounting Google Cloud credentials (bind-mount, ro): $gcloud_creds"
  if [[ -n "$selinux_label" ]]; then
    args+=(-v "$gcloud_creds:$gcloud_creds:Z,ro")
  else
    args+=(-v "$gcloud_creds:$gcloud_creds:ro")
  fi
  args+=(-e GOOGLE_APPLICATION_CREDENTIALS="$gcloud_creds")
  args+=(-e VERTEXAI_PROJECT=REDACTED-GCP-PROJECT)
  args+=(-e VERTEXAI_LOCATION=global)
  echo "  → Setting GOOGLE_APPLICATION_CREDENTIALS=$gcloud_creds"
  echo "  → Setting VERTEXAI_PROJECT=REDACTED-GCP-PROJECT"
  echo "  → Setting VERTEXAI_LOCATION=global"
else
  echo "✗ Google Cloud credentials not found: $gcloud_creds" >&2
fi

# Claude config directory
if [[ -d "$claude_dir" ]]; then
  echo "✓ Mounting Claude config directory (bind-mount, rw): $claude_dir"
  args+=(-v "$claude_dir:$claude_dir${selinux_label}")
else
  echo "✗ Claude config directory not found: $claude_dir" >&2
fi

# Claude config file
if [[ -f "$claude_json" ]]; then
  echo "✓ Mounting Claude config file (bind-mount, rw): $claude_json"
  args+=(-v "$claude_json:$claude_json${selinux_label}")
else
  echo "✗ Claude config file not found: $claude_json" >&2
fi

# GitHub CLI config
if [[ -d "$gh_config" ]]; then
  echo "✓ Mounting GitHub CLI config (bind-mount, ro): $gh_config"
  if [[ -n "$selinux_label" ]]; then
    args+=(-v "$gh_config:$gh_config:Z,ro")
  else
    args+=(-v "$gh_config:$gh_config:ro")
  fi
else
  echo "✗ GitHub CLI config not found: $gh_config" >&2
fi

# GitLab CLI config
if [[ -d "$glab_config" ]]; then
  echo "✓ Mounting GitLab CLI config (bind-mount, ro): $glab_config"
  if [[ -n "$selinux_label" ]]; then
    args+=(-v "$glab_config:$glab_config:Z,ro")
  else
    args+=(-v "$glab_config:$glab_config:ro")
  fi
else
  echo "✗ GitLab CLI config not found: $glab_config" >&2
fi

# SSH agent
if [[ -n "$SSH_AUTH_SOCK" ]] && [[ -S "$SSH_AUTH_SOCK" ]]; then
  echo "✓ Mounting SSH agent socket (bind-mount, rw): $SSH_AUTH_SOCK"
  args+=("--mount=type=bind,source=${SSH_AUTH_SOCK},target=${SSH_AUTH_SOCK}$([ -n "$selinux_label" ] && echo ",z")")
  args+=(-e SSH_AUTH_SOCK)
  echo "  → Setting SSH_AUTH_SOCK=$SSH_AUTH_SOCK"
else
  echo "✗ SSH agent socket not available" >&2
fi

# SSH known_hosts
if [[ -f "$ssh_known_hosts" ]]; then
  echo "✓ Mounting SSH known_hosts (bind-mount, ro): $ssh_known_hosts"
  if [[ -n "$selinux_label" ]]; then
    args+=(-v "$ssh_known_hosts:$ssh_known_hosts:Z,ro")
  else
    args+=(-v "$ssh_known_hosts:$ssh_known_hosts:ro")
  fi
else
  echo "✗ SSH known_hosts not found: $ssh_known_hosts" >&2
fi

# Git config
if [[ -f "$gitconfig" ]]; then
  echo "✓ Mounting Git config (bind-mount, ro): $gitconfig"
  if [[ -n "$selinux_label" ]]; then
    args+=(-v "$gitconfig:$gitconfig:Z,ro")
  else
    args+=(-v "$gitconfig:$gitconfig:ro")
  fi
else
  echo "✗ Git config not found: $gitconfig" >&2
fi

# OSC config
#if [[ -d "$osc" ]]; then
#  echo "✓ Mounting OSC config (bind-mount, ro): $osc"
#  if [[ -n "$selinux_label" ]]; then
#    args+=(-v "$osc:$osc:Z,ro")
#  else
#    args+=(-v "$osc:$osc:ro")
#  fi
#else
#  echo "✗ OSC config not found: $osc" >&2
#fi

# GPG agent
if [[ -S "$gpg_socket" ]]; then
  echo "✓ Mounting GPG agent socket (bind-mount, rw): $gpg_socket"
  args+=("--mount=type=bind,source=${gpg_socket},target=${gpg_socket}$([ -n "$selinux_label" ] && echo ",z")")
else
  echo "✗ GPG agent socket not found: $gpg_socket" >&2
fi

echo "✓ Mounting working directory (bind-mount, rw): ${PWD}"

args+=("--network=slirp4netns")
#args+=("--runtime crun-vm")

echo "▶ Using entrypoint: $entrypoint"
echo ""

podman run --entrypoint "$entrypoint" "${args[@]}" ai "${remaining_args[@]}"
