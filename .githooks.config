; Config-driven Git hooks (requires Git >= 2.55, see githooks[5]/git-config[1]
; "hook.<name>.*" keys). Tracked in the repo so everyone shares the same
; checks, but git deliberately only honors hook.* from "protected"
; configuration (system/global/command scopes) -- never from local repo
; config -- so this file does nothing until you opt in once per clone:
;
;   git config set --local include.path ../.githooks.config
;
; (run from the repo root; the path is resolved relative to .git/config).
; See AGENTS.md for details.

; pre-push commands are wrapped in `sh -c '...' --` because Git passes each
; pre-push hook the remote name and URL as positional arguments; without an
; explicit subshell those leak straight into the command's own argv (e.g.
; `uv run pytest -q origin git@...`), which mypy/pytest then try to treat as
; file paths. The extra `--`/args become the subshell's own $0/$1 instead,
; and are ignored since the command text never references them.

[hook "ai-container-lint"]
	event = pre-commit
	command = uv run ruff format --check . && uv run ruff check .

[hook "ai-container-hardcoded-config"]
	event = pre-commit
	command = uv run python scripts/check_hardcoded_config.py

[hook "ai-container-secrets"]
	event = pre-commit
	command = gitleaks git --pre-commit --staged -v .

[hook "ai-container-typecheck"]
	event = pre-push
	command = sh -c 'uv run mypy' --

[hook "ai-container-test"]
	event = pre-push
	command = sh -c 'uv run pytest -q' --
